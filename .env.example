# ─── MorniHosting ─────────────────────────────────────────────
# Kopiere diese Datei nach `.env` und passe sie an.

# Pflicht: ein langer Zufallswert. Erzeugen mit:  openssl rand -hex 32
MH_SECRET=

# Port, unter dem das Panel im Browser erreichbar ist (http://<IP>:8080)
MH_PANEL_PORT=8080

# IP dieses Rechners im Heimnetz, damit die IP-Karte sie anzeigen kann (z. B. 192.168.178.40)
MH_LAN_IP=

# Optional: Domain oder DynDNS-Name, unter dem Freunde deine Server erreichen (z. B. mc.example.de)
MH_PUBLIC_ADDRESS=

# Zeitzone für Zeitpläne und Protokolle
TZ=Europe/Berlin

# Läuft das Panel hinter einem Reverse-Proxy mit HTTPS (Nginx Proxy Manager, Traefik, Caddy)? Dann true.
MH_TRUST_PROXY=false

# Docker-Images für die Server (nur ändern, wenn du weißt, was du tust)
# MH_IMAGE_JAVA=itzg/minecraft-server
# MH_IMAGE_BEDROCK=itzg/minecraft-bedrock-server
# MH_IMAGE_PROXY=itzg/mc-proxy
